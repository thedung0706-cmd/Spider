<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="rescue_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="brick_obstacle">
      <pose>0.4 0 0.05 0 0 0</pose> 
      <static>true</static> <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.15 0.5 0.1</size></box> </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.15 0.5 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.3 0.1 1.0</ambient> </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>