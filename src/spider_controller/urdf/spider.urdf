<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spider">

  <!-- DUMMY LINK -->
  <link name="dummy_link"/>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy_link"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="dark_gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0013" ixy="0.0" ixz="0.0" iyy="0.0013" iyz="0.0" izz="0.0025"/>
    </inertial>
  </link>

  <xacro:macro name="leg" params="prefix x y angle coxa_dir">
    <link name="coxa_${prefix}">
      <visual>
        <geometry><box size="0.04 0.04 0.04"/></geometry>
        <material name="red"><color rgba="1 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.04 0.04 0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="joint_coxa_${prefix}" type="revolute">
      <parent link="base_link"/>
      <child link="coxa_${prefix}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 ${angle}"/>
      <axis xyz="0 0 ${coxa_dir}"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="femur_${prefix}">
      <visual>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <geometry><box size="0.08 0.03 0.03"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <geometry><box size="0.08 0.03 0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00006" iyz="0.0" izz="0.00006"/>
      </inertial>
    </link>

    <joint name="joint_femur_${prefix}" type="revolute">
      <parent link="coxa_${prefix}"/>
      <child link="femur_${prefix}"/>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <!-- Đảo chiều trục Y thành âm để ép đùi gập xuống -->
      <axis xyz="0 -1 0"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="tibia_${prefix}">
      <visual>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <geometry><box size="0.12 0.02 0.02"/></geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <geometry><box size="0.12 0.02 0.02"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00006" iyz="0.0" izz="0.00006"/>
      </inertial>
    </link>

    <joint name="joint_tibia_${prefix}" type="revolute">
      <parent link="femur_${prefix}"/>
      <child link="tibia_${prefix}"/>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <!-- Đảo chiều trục Y thành âm để cẳng chân cắm xuống đất -->
      <axis xyz="0 -1 0"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>
  </xacro:macro>

  <xacro:leg prefix="R1" x="0.0866" y="-0.05" angle="-0.523" coxa_dir="1"/> 
  <xacro:leg prefix="R2" x="0.0"    y="-0.1"  angle="-1.571" coxa_dir="1"/>
  <xacro:leg prefix="R3" x="-0.0866" y="-0.05" angle="-2.618" coxa_dir="1"/>
  
  <xacro:leg prefix="L1" x="0.0866" y="0.05"  angle="0.523" coxa_dir="-1"/> 
  <xacro:leg prefix="L2" x="0.0"    y="0.1"   angle="1.571" coxa_dir="-1"/>
  <xacro:leg prefix="L3" x="-0.0866" y="0.05"  angle="2.618" coxa_dir="-1"/>

  <xacro:macro name="leg_control" params="prefix">
    <joint name="joint_coxa_${prefix}">
      <command_interface name="effort">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_femur_${prefix}">
      <command_interface name="effort">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_tibia_${prefix}">
      <command_interface name="effort">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:leg_control prefix="R1"/>
    <xacro:leg_control prefix="R2"/>
    <xacro:leg_control prefix="R3"/>
    <xacro:leg_control prefix="L1"/>
    <xacro:leg_control prefix="L2"/>
    <xacro:leg_control prefix="L3"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find spider_controller)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.02"/></geometry>
      <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.05 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 0.05" rpy="0 0 0"/> 
  </joint>

  <gazebo reference="camera_link">
    <sensor type="camera" name="spider_camera">
      <update_rate>30.0</update_rate>
      <topic>camera/image_raw</topic>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
    </sensor>
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="spider_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>

</robot>